# Required: generate a random gateway key, for example: openssl rand -hex 32
GATEWAY_API_KEY=replace-with-a-long-random-key
GATEWAY_PORT=8787

# Optional: limit the visible and executable provider catalog.
# GATEWAY_ALLOWED_PROVIDERS=exa,apify,firecrawl,tinyfish

# Add only the provider credentials you want to use.
# The inspect API shows canonical variable names; single-key providers also
# accept the upstream <PROVIDER>_API_KEY alias.
# EXA_CREDENTIALS_API_KEY=
# APIFY_CREDENTIALS_API_KEY=
# FIRECRAWL_CREDENTIALS_API_KEY=
# TINYFISH_CREDENTIALS_API_KEY=
